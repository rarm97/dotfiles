#!/usr/bin/env bash
# tmux-sessionizer — fuzzy-find a project directory and open it in a named tmux session
# Inspired by ThePrimeagen

# Directories to search for projects (depth 1)
SEARCH_DIRS=(
  ~/dotfiles
  ~/learning
  ~/coding_projects
  ~/gloryandgains
  ~
)

if [[ $# -eq 1 ]]; then
  selected=$1
else
  # Build list: the search dirs themselves + their immediate children
  selected=$(
    (
      for d in "${SEARCH_DIRS[@]}"; do
        [[ -d "$d" ]] && echo "$d"
        [[ -d "$d" ]] && find "$d" -mindepth 1 -maxdepth 1 -type d
      done
    ) | awk '!seen[$0]++' | fzf
  )
fi

[[ -z "$selected" ]] && exit 0

# Session name: basename, dots replaced with underscores (tmux dislikes dots)
session_name=$(basename "$selected" | tr . _)

# Two search roots can hold projects with the same basename (~/coding_projects/api
# and ~/learning/api both want to be "api"). Without this, picking the second one
# just switches to the first one's session and silently takes you to the wrong
# code. If the name is taken by a session rooted somewhere else, qualify it with
# its parent directory.
#
# The path has to come from `list-sessions -F` — `display-message -p -t "=name"`
# expects a pane target and returns empty for a session name.
existing_path=$(
  tmux list-sessions -F '#{session_name}	#{session_path}' 2>/dev/null |
    awk -F'\t' -v n="$session_name" '$1 == n { print $2; exit }'
)
if [[ -n "$existing_path" && "$existing_path" != "$selected" ]]; then
  parent=$(basename "$(dirname "$selected")" | tr . _)
  session_name="${parent}_${session_name}"
fi

# If not inside tmux, create or attach
if [[ -z "${TMUX:-}" ]]; then
  tmux new-session -A -s "$session_name" -c "$selected"
else
  # Create session in background if it doesn't exist
  if ! tmux has-session -t="$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
  fi
  tmux switch-client -t "$session_name"
fi
