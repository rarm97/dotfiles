#!/usr/bin/env bash
# Assert this setup's assumptions before every commit. ~1s.
#
# The point of check.sh is that it runs without anyone remembering to run it —
# otherwise the repo's health depends on someone deciding to look, which is how
# it accumulated months of silent defects in the first place.
#
# Bypass for a genuinely unrelated commit with: git commit --no-verify
exec "$(git rev-parse --show-toplevel)/check.sh"
